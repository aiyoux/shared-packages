{
  "name": "@shared-packages/vectorize",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lazy raster-to-SVG engines: VTracer 1.0 (WASM) and Potrace (GPL WASM).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "build:wasm": "wasm-pack build crates/vtracer-wasm --target bundler --out-dir src/wasm --release",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "esm-potrace-wasm": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
