{
  "name": "@shared-packages/pdf",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "pdf.js interpreter: open, rasterize, and map a page to editable IR (text/path/image/group).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./service": {
      "types": "./src/service/index.ts",
      "import": "./src/service/index.ts",
      "default": "./src/service/index.ts"
    },
    "./service/assets": {
      "types": "./src/service/assets.ts",
      "import": "./src/service/assets.ts",
      "default": "./src/service/assets.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
