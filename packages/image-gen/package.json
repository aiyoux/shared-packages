{
  "name": "@shared-packages/image-gen",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser text-to-image engines (Stable Diffusion via onnxruntime-web WebGPU) with a VFS-backed model store.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/sd.worker.ts",
      "import": "./src/sd.worker.ts",
      "default": "./src/sd.worker.ts"
    },
    "./flux2-worker": {
      "types": "./src/flux2.worker.ts",
      "import": "./src/flux2.worker.ts",
      "default": "./src/flux2.worker.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
