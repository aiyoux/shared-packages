{
  "name": "@shared-packages/image",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lazy-loaded browser image engines (native Canvas + jSquash WASM) for convert, resize, and JPEG quality.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
    "yalc:publish": "yalc publish"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.0.1",
    "@jsquash/resize": "^2.1.0",
    "@jsquash/webp": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
