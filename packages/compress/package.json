{
  "name": "@shared-packages/compress",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lazy-loaded browser compression engines (fflate, ZipKit WASM, AddMaple gzip/brotli/lz4) with a shared pack/expand API.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
    "yalc:publish": "yalc publish"
  },
  "dependencies": {
    "@addmaple/brotli": "^0.2.0",
    "@addmaple/gzip": "^0.2.0",
    "@addmaple/lz4": "^0.2.0",
    "@myrialabs/zipkit": "^0.0.11",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
