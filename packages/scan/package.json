{
  "name": "@shared-packages/scan",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser document scan: lazy OpenCV.js page detect + warp, optional enhance/OCR, multi-page PDF.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "test": "vitest run",
    "bench": "node --experimental-strip-types --import ./tools/detect-bench/register.mjs ./tools/detect-bench/scenes.cjs && node --experimental-strip-types --import ./tools/detect-bench/register.mjs ./tools/detect-bench/bench.mjs",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@shared-packages/model-store": "file:../model-store",
    "@shared-packages/ocr": "file:../ocr",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "pdf-lib": "^1.17.1",
    "scanic": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
