{
  "name": "@shared-packages/video",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser video trim/export with WebCodecs + mediabunny (H.264 MP4) and reusable editor/player UI.",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./VideoTimeline.svelte": "./src/VideoTimeline.svelte",
    "./trimTimeline": {
      "types": "./src/trimTimeline.svelte.ts",
      "svelte": "./src/trimTimeline.svelte.ts",
      "default": "./src/trimTimeline.svelte.ts"
    },
    "./VideoTransport.svelte": "./src/VideoTransport.svelte",
    "./MediaControlsBar.svelte": "./src/MediaControlsBar.svelte",
    "./VideoProcessPanel.svelte": "./src/VideoProcessPanel.svelte",
    "./AudioChunkControls.svelte": "./src/AudioChunkControls.svelte",
    "./audioChunking": "./src/audioChunking.ts",
    "./VideoPlayer.svelte": "./src/VideoPlayer.svelte",
    "./VideoLightbox.svelte": "./src/VideoLightbox.svelte"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mediabunny": "^1.50.9"
  },
  "peerDependencies": {
    "@lucide/svelte": "^0.554.0",
    "@shared-packages/composition": "*",
    "@shared-packages/ui": "*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
