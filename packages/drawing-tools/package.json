{
  "name": "@shared-packages/drawing-tools",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Headless 2D drawing primitives — brush/path/raster/clip/erase — shared by svg-sketcher and web_social_games.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/eraser.worker.ts",
      "default": "./src/eraser.worker.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test test/*.test.js test/*.test.ts",
    "yalc:publish": "yalc publish"
  },
  "dependencies": {
    "clipper2-wasm": "^0.4.0",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}