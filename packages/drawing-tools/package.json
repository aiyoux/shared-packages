{
  "name": "@shared-packages/drawing-tools",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Headless 2D drawing primitives — brush/path/raster/clip/erase — shared by svg-sketcher and web_social_games.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/eraser.worker.ts",
      "default": "./src/eraser.worker.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --external:perfect-freehand --external:polygon-clipping --external:clipper2-wasm --sourcemap",
    "test": "node --experimental-test-module-mocks --test test/*.test.js test/*.test.ts"
  },
  "dependencies": {
    "clipper2-wasm": "^0.4.0",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}